{
  "ConnectionStrings": {
    "ManagementDatabase": "Data Source=data/tempy-management.db;Cache=Shared;Foreign Keys=True;Default Timeout=30"
  },
  "Server": {
    "ListenAddress": "192.168.1.100",
    "Port": 8765,
    "AdvertisedHost": "192.168.1.100",
    "UseHttps": false,
    "CertificatePath": "",
    "CertificatePassword": "",
    "HeartbeatIntervalSeconds": 15,
    "HeartbeatTimeoutSeconds": 45,
    "PresenceSweepSeconds": 5,
    "DispatchIntervalSeconds": 2,
    "SyncDispatchIntervalSeconds": 3,
    "MaximumMessageBytes": 262144,
    "MaximumCommandOutputBytes": 65536,
    "MaximumCommandErrorBytes": 16384,
    "MaximumDeliveryAttempts": 10,
    "InitialRetrySeconds": 5,
    "MaximumRetrySeconds": 300,
    "CommandExecutionTimeoutMinutes": 120,
    "DefaultDnsServer": "192.168.1.100"
  },
  "Security": {
    "AllowNewDeviceEnrollment": false,
    "AllowEnrollmentTokenForExistingDevices": false,
    "AgentEnrollmentToken": "",
    "RequireHttpsForAdmin": false,
    "CookieMinutes": 480
  },
  "BootstrapAdmin": {
    "Username": "",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
