{
  "Agent": {
    "ServerUrl": "https://om-server.local:8443",
    "FallbackServerUrls": [ "https://192.168.1.100:8443" ],
    "SignalRHubPath": "/omHub",
    "AuthKey": "",
    "MachineId": "",
    "HeartbeatIntervalSeconds": 30,
    "OfflineGraceSeconds": 100,
    "JobPollIntervalSeconds": 10,
    "SyncIntervalSeconds": 60,
    "MaxBackoffSeconds": 120,
    "DefaultJobTimeoutSeconds": 600,
    "VerifyServerCertificate": true,
    "DataDirectory": "C:\\ProgramData\\OM\\Client",
    "ServiceName": "OMClientAgent",
    "StartupDelayMilliseconds": 3000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning"
    }
  }
}
